        "km": "សុខា"
      },
      "gender": "f",
      "learns": [
        "fr",
        "en"
      ],
      "reference": "km",
      "label": "Elle"
    },
    "B": {
      "role": "french",
      "name": {
        "latin": "Dominique",
        "km": "ដូមីនិក"
      },
      "gender": "m",
      "learns": [
        "en",
        "km"
      ],
      "reference": "fr",
      "label": "Lui"
    }
